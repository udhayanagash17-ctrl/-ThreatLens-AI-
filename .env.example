# ThreatLens AI Environment Configuration

# Backend
SECRET_KEY=your-super-secret-key-change-in-production
DATABASE_URL=sqlite:///./threatlens.db
DEBUG=true

# AI Configuration
AI_ENABLED=true
AI_API_KEY=your-openai-api-key-here
